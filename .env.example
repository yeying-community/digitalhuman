# === Public endpoints ===
PUBLIC_VTUBER_HOST=vtuber.yeying.pub
PUBLIC_VTUBER_SCHEME=https
PUBLIC_LLM_HOST=llm-round.yeying.pub
PUBLIC_LLM_SCHEME=http
VTUBER_SESSION_PATH_PREFIX=/s

# 监听端口（docker-compose 会引用）
ORCH_PORT=9009
VTUBER_PORT=12393
LOG_LEVEL=INFO

# Docker 编排设置
VTUBER_IMAGE=dh-vtuber:latest
LLM_IMAGE=dh-llm-round:latest
DH_DOCKER_NETWORK=dhnet
SESSION_MAX_IDLE_SECONDS=900
SESSION_MAX_AGE_SECONDS=7200
SESSION_CLEANUP_INTERVAL=60

# MinIO（按你们实际填，若无可先留空）
MINIO_ENDPOINT=https://test-minio.yeying.pub
MINIO_ACCESS_KEY=changeme
MINIO_SECRET_KEY=changeme
MINIO_BUCKET=yeying-interviewer
MINIO_SECURE=true
